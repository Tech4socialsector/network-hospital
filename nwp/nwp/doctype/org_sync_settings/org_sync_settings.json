 "fields": [
  {
   "default": "0",
   "description": "Tick this only on the one central site that receives data from every partner organization. It changes what the Central Sync Status page shows — the central site sees data received by organization, not an outbound push status (central never pushes anywhere).",
   "fieldname": "is_central_site",
   "fieldtype": "Check",
   "label": "This Is The Central Site"
  },
  {
   "default": "0",
   "fieldname": "enable_sync",
   "fieldtype": "Check",
   "label": "Enable Sync To Central"
  },
  {
   "default": "Daily At A Specific Time",
   "fieldname": "sync_frequency",
   "fieldtype": "Select",
   "label": "Sync Frequency",
   "options": "Every N Minutes\nDaily At A Specific Time"
  },
  {
   "default": "60",
   "depends_on": "eval:doc.sync_frequency==\"Every N Minutes\"",
   "fieldname": "poll_interval_minutes",
   "fieldtype": "Int",
   "label": "Poll Interval (minutes)"
  },
  {
   "default": "05:00:00",
   "depends_on": "eval:doc.sync_frequency==\"Daily At A Specific Time\"",
   "fieldname": "sync_time",
   "fieldtype": "Time",
   "label": "Sync Time"
  },
  {
   "fieldname": "column_break_general",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_run_at",
   "fieldtype": "Datetime",
   "label": "Last Run At",
   "read_only": 1
  },
  {
   "fieldname": "last_run_status",
   "fieldtype": "Small Text",
   "label": "Last Run Status",
   "read_only": 1
  },
  {
   "description": "When the automatic daily/interval schedule itself last actually fired — separate from Last Run At, which also updates on a manual Run Now click. Keeps a manual test run from making the scheduler think today's run is already done.",
   "fieldname": "last_scheduled_run_at",
   "fieldtype": "Datetime",
   "hidden": 1,
   "label": "Last Scheduled Run At",
   "read_only": 1
  },
  {
   "description": "If the sync keeps failing for this many runs in a row, send a one-time warning email here.",
   "fieldname": "alert_email",
   "fieldtype": "Data",
   "label": "Alert Email On Repeated Failure",
   "options": "Email"
  },
  {
   "default": "3",
   "depends_on": "eval:doc.alert_email",
   "fieldname": "failure_alert_threshold",
   "fieldtype": "Int",
   "label": "Failure Alert Threshold (Consecutive Runs)"
  },
  {
   "description": "Tick any fields you do not want shared with the central site. Everything else in each list is still pushed on every sync; a few core fields (patient ID, organization, approval status) are always sent regardless, since central needs them to identify and link records correctly.",
